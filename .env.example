# Database & Redis
DATABASE_URL="postgresql://kculture_user:kculture_password@localhost:5432/kculture_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Google Maps API (Next.js client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_key"

# Kakao Map API
NEXT_PUBLIC_KAKAO_MAP_JS_KEY="your_kakao_map_javascript_key"
KAKAO_MAP_REST_KEY="your_kakao_map_rest_api_key"

# Public APIs (data.go.kr, kma, kosis)
